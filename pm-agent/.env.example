# Copy to .env and fill in. Never commit the real file.

# From @BotFather on Telegram: /newbot, then copy the token.
TELEGRAM_BOT_TOKEN=

# Comma-separated chat ids allowed to talk to the bot.
# Leave empty on first run, message the bot once, and read the id out of the log.
# An open PM bot leaks contract sums and rates - the allowlist is not optional.
TELEGRAM_ALLOWED_CHAT_IDS=

# Where the Project Ledger lives. Point this at a PRIVATE git repo, outside this
# one. Defaults to ../projects relative to pm-agent if unset.
LEDGER_ROOT=/Users/you/ledger/projects

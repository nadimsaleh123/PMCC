# Copy to .env and fill in. Never commit the real file.

# From @BotFather on Telegram: /newbot, then copy the token.
TELEGRAM_BOT_TOKEN=

# Comma-separated chat ids allowed to talk to the bot.
# Leave empty on first run, message the bot once, and read the id out of the log.
# An open PM bot leaks contract sums and rates - the allowlist is not optional.
TELEGRAM_ALLOWED_CHAT_IDS=

# Where the Project Ledger lives. Point this at a PRIVATE git repo, outside this
# one. Defaults to ../projects relative to pm-agent if unset.
LEDGER_ROOT=/Users/you/ledger/projects

# --- Question answering (/ask) --------------------------------------------
# Needs Claude Code installed and authenticated on this machine:
#   npm i -g @anthropic-ai/claude-code && claude setup-token
# Runs strictly read-only against the project folder.
PM_CLAUDE_MODEL=sonnet
# Cap per question, passed to the CLI.
PM_CLAUDE_BUDGET_USD=0.5
# Cap per day across all questions. A runaway loop should cost a few dollars,
# not a few hundred. Roughly 20 questions at typical ledger size.
PM_CLAUDE_DAILY_USD=5
# Override the binary if it is not on PATH.
# PM_CLAUDE_BIN=/opt/homebrew/bin/claude

# --- Voice notes ----------------------------------------------------------
# Speech to text runs as a command, so any engine works. Local keeps site audio
# on this machine, which is the point:
#   brew install ffmpeg whisper-cpp
#   curl -L -o ~/.whisper/ggml-base.en.bin \
#     https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin
#
# {input} and {output} are substituted. Leave unset and the bot asks for text.
# PM_TRANSCRIBE_CMD=whisper-cli -m ~/.whisper/ggml-base.en.bin -f {input} --output-txt --output-file {output} -nt
#
# Set to 1 for an engine that takes OGG directly, skipping the ffmpeg step.
# PM_TRANSCRIBE_ACCEPTS_OGG=1
# PM_FFMPEG=ffmpeg
# PM_TRANSCRIBE_TIMEOUT_MS=300000
